+      VK_PIPELINE_STAGE_TRANSFER_BIT, entry->written ? VK_ACCESS_TRANSFER_READ_BIT : 0,
+      VK_ACCESS_TRANSFER_WRITE_BIT,
+      entry->written ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
