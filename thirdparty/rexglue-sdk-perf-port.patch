+  if (swap_red_blue) {
+    // RGBA -> BGRA conversion by the blit: the channels keep their meaning, so the bytes in the
+    // snapshot are B, G, R, A.
+    VkImageBlit blit = {};
+    blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    blit.srcOffsets[0] = {int32_t(x), int32_t(y), 0};
+    blit.srcOffsets[1] = {int32_t(x + width), int32_t(y + height), 1};
+    blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    blit.dstOffsets[0] = {0, 0, 0};
+    blit.dstOffsets[1] = {int32_t(width), int32_t(height), 1};
+    command_processor_.deferred_command_buffer().CmdVkBlitImage(
+        source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, entry->image,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_NEAREST);
