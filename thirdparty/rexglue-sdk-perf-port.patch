+// Not inlined: its return address is a point inside the function that took the lock.
+__attribute__((noinline)) void GlobalLockAcquireProfiled(std::recursive_mutex& mutex) {
+  const uintptr_t site = uintptr_t(__builtin_return_address(0));
+  if (!mutex.try_lock()) {
+    const int holder = global_lock_owner_tid.load(std::memory_order_relaxed);
+    const uintptr_t holder_site = global_lock_owner_site.load(std::memory_order_relaxed);
+    const auto start = std::chrono::steady_clock::now();
+    mutex.lock();
+    const uint64_t waited = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                         std::chrono::steady_clock::now() - start).count());
+    const int self = CurrentTid();
+    std::lock_guard<std::mutex> guard(global_lock_stats_mutex);
+    GlobalLockContention* record = nullptr;
+    for (auto& r : global_lock_stats) {
+      if (r.waiter_tid == self && r.waiter_site == site && r.holder_tid == holder &&
+          r.holder_site == holder_site) {
+        record = &r;
+        break;
+      }
+    }
+    if (!record) {
+      if (global_lock_stats.size() < kMaxGlobalLockRecords) {
+        global_lock_stats.push_back({self, holder, site, holder_site, 0, 0});
+      } else {
+        // Table full: fold into one catch-all record.
+        global_lock_stats.back() = {0, 0, 0, 0, global_lock_stats.back().wait_ns,
+                                    global_lock_stats.back().count};
+      }
+      record = &global_lock_stats.back();
+    }
+    record->wait_ns += waited;
+    ++record->count;
+  }
+  // Nested (recursive) acquisitions overwrite the site with the inner one.
+  global_lock_owner_tid.store(CurrentTid(), std::memory_order_relaxed);
+  global_lock_owner_site.store(site, std::memory_order_relaxed);
