+#if defined(__ANDROID__)
+struct ThermalApi {
+  using Acquire = void* (*)();
+  using Status = int (*)(void*);
+  using Headroom = float (*)(void*, int);
+  void* manager = nullptr;
+  Status status = nullptr;
+  Headroom headroom = nullptr;
+  ThermalApi() {
+    void* android = dlopen("libandroid.so", RTLD_NOW);
+    if (!android) return;
+    auto acquire = reinterpret_cast<Acquire>(dlsym(android, "AThermal_acquireManager"));
+    status = reinterpret_cast<Status>(dlsym(android, "AThermal_getCurrentThermalStatus"));
+    headroom = reinterpret_cast<Headroom>(dlsym(android, "AThermal_getThermalHeadroom"));
+    if (acquire) manager = acquire();
+  }
+};
+#endif
+
+void ThermalLoggerMain() {
+#if defined(__ANDROID__)
+  ThermalApi api;
+#endif
+  // Samsung Xclipse / Mali, then Adreno (kgsl). Unreadable paths (SELinux) are skipped.
+  const char* gpu_paths[] = {"/sys/kernel/gpu/gpu_clock", "/sys/kernel/gpu/gpu_max_clock",
+                             "/sys/class/misc/mali0/device/clock", "/sys/devices/platform/gpu/clock",
+                             "/sys/class/kgsl/kgsl-3d0/gpuclk", "/sys/class/kgsl/kgsl-3d0/max_gpuclk",
+                             "/sys/class/kgsl/kgsl-3d0/devfreq/cur_freq",
+                             "/sys/class/kgsl/kgsl-3d0/gpu_busy_percentage"};
+  bool reported_unreadable = false;
+  for (;;) {
+    std::string line;
+#if defined(__ANDROID__)
+    if (api.manager && api.status) line += " status=" + std::to_string(api.status(api.manager));
+    if (api.manager && api.headroom) {
+      char text[32];
+      // Headroom 1.0 means the device reaches severe throttling; forecast 10 s ahead.
+      std::snprintf(text, sizeof(text), " headroom=%.2f", double(api.headroom(api.manager, 10)));
+      line += text;
+    }
+#endif
+    std::string cpus;
+    for (int policy = 0; policy < 12; ++policy) {
+      const std::string base = "/sys/devices/system/cpu/cpufreq/policy" + std::to_string(policy) + "/";
+      long current = 0, cap = 0, hardware = 0;
+      if (!ThermalReadLong(base + "scaling_cur_freq", current)) continue;
+      ThermalReadLong(base + "scaling_max_freq", cap);
+      ThermalReadLong(base + "cpuinfo_max_freq", hardware);
+      cpus += " p" + std::to_string(policy) + "=" + std::to_string(current / 1000) + "/" +
+              std::to_string(cap / 1000) + "/" + std::to_string(hardware / 1000);
+    }
+    if (!cpus.empty()) line += " cpu_MHz(cur/cap/max):" + cpus;
+    for (const char* path : gpu_paths) {
+      long value = 0;
+      if (ThermalReadLong(path, value)) line += std::string(" ") + (std::strrchr(path, '/') + 1) + "=" + std::to_string(value);
+    }
+    std::string zones;
+    int readable = 0;
+    for (int zone = 0; zone < 64 && readable < 16; ++zone) {
+      const std::string base = "/sys/class/thermal/thermal_zone" + std::to_string(zone) + "/";
+      long temperature = 0;
+      std::string type;
+      if (!ThermalReadLong(base + "temp", temperature)) continue;
+      if (!ThermalReadWord(base + "type", type)) type = "zone" + std::to_string(zone);
+      char text[96];
+      std::snprintf(text, sizeof(text), " %s=%.1f", type.c_str(), double(temperature) / 1000.0);
+      zones += text;
+      ++readable;
+    }
+    if (!zones.empty()) line += " temp_C:" + zones;
+    else if (!reported_unreadable) { line += " temp_C:unreadable"; reported_unreadable = true; }
+    REXGPU_INFO("Thermal:{}", line);
+    std::this_thread::sleep_for(std::chrono::seconds(5));
+  }
+}
+
+void StartThermalLogger() {
+  static std::once_flag once;
+  std::call_once(once, [] { std::thread(ThermalLoggerMain).detach(); });
+}
