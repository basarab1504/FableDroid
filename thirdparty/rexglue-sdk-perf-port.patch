+        candidate.image_width >= width && candidate.image_height >= height) {
+      entry = &candidate;
+      break;
+    }
+  }
+  if (!entry) {
+    for (ResolveSnapshot& candidate : snapshots.entries) {
+      if (!candidate.valid && candidate.format == format && candidate.image_width >= width &&
+          candidate.image_height >= height &&
+          candidate.image_width <= width * 2 && candidate.image_height <= height * 2) {
+        entry = &candidate;
+        break;
