+#if !REX_PLATFORM_WIN32
+// log_thermal: every 5 seconds log Android's thermal headroom and status, the current and
+// maximum (throttle cap) frequency of each CPU frequency policy, and any readable GPU clock
+// and thermal zone. Shows directly when and how hard the device throttles.
+bool ThermalReadLong(const std::string& path, long& value) {
+  FILE* file = std::fopen(path.c_str(), "r");
+  if (!file) return false;
+  const bool ok = std::fscanf(file, "%ld", &value) == 1;
+  std::fclose(file);
+  return ok;
+}
+bool ThermalReadWord(const std::string& path, std::string& value) {
+  FILE* file = std::fopen(path.c_str(), "r");
+  if (!file) return false;
+  char buffer[64] = {};
+  const bool ok = std::fscanf(file, "%63s", buffer) == 1;
+  std::fclose(file);
+  if (ok) value = buffer;
+  return ok;
+}
