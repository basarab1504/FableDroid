+SharedMemory::HotPageStats SharedMemory::TakeHotPageStats(uint32_t& hot_now) {
+  auto global_lock = global_critical_region_.Acquire();
+  HotPageStats stats = hot_page_stats_;
+  hot_page_stats_ = {};
+  hot_now = hot_page_count_.load(std::memory_order_relaxed);
+  return stats;
+}
