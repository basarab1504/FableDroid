+namespace {
+struct ResolveSnapshot {
+  uint32_t address = 0, length = 0, width = 0, height = 0, pitch_texels = 0, endian = 0;
+  uint32_t image_width = 0, image_height = 0;
+  VkFormat format = VK_FORMAT_R8G8B8A8_UNORM;
+  VkImage image = VK_NULL_HANDLE;
+  VkDeviceMemory memory = VK_NULL_HANDLE;
+  bool valid = false;
+  // false: never written (UNDEFINED); true: TRANSFER_SRC_OPTIMAL after the last capture.
+  bool written = false;
+};
+struct ResolveSnapshots {
+  static constexpr size_t kMax = 48;
+  std::mutex mutex;
+  std::vector<ResolveSnapshot> entries;
+  // Registered once, outside `mutex`: the watch callback runs under the shared memory global lock
+  // and then takes `mutex`, so `mutex` must never be held while taking the global lock.
+  std::atomic<bool> watch_registered{false};
+  SharedMemory::GlobalWatchHandle watch = nullptr;
+  uint64_t captures = 0, invalidations = 0, cpu_invalidations = 0, hits = 0, misses = 0;
+  std::array<uint64_t, 8> miss_reasons = {};
+  std::array<uint64_t, size_t(VulkanTextureCache::SnapshotSkip::kCount)> skips = {};
+  uint64_t swapped_captures = 0;
+  std::chrono::steady_clock::time_point window = std::chrono::steady_clock::now();
+};
+ResolveSnapshots& resolve_snapshots() {
+  static ResolveSnapshots snapshots;
+  return snapshots;
+}
+void InvalidateSnapshotsLocked(ResolveSnapshots& snapshots, uint32_t first, uint32_t last,
+                               uint32_t keep_address) {
+  for (ResolveSnapshot& entry : snapshots.entries) {
+    if (!entry.valid || !entry.length || entry.address == keep_address) continue;
+    if (first < entry.address + entry.length && entry.address <= last) {
+      entry.valid = false;
+      ++snapshots.invalidations;
+    }
+  }
+}
+void ResolveSnapshotsGlobalWatch(const std::unique_lock<std::recursive_mutex>&, void*,
+                                 uint32_t address_first, uint32_t address_last,
+                                 bool invalidated_by_gpu) {
+  // CPU writes, and GPU writes other than resolves (memexport). A resolve also fires this
+  // (invalidated_by_gpu), but before it captures its new snapshot, so that is harmless.
+  ResolveSnapshots& snapshots = resolve_snapshots();
+  std::lock_guard<std::mutex> lock(snapshots.mutex);
+  const uint64_t before = snapshots.invalidations;
+  InvalidateSnapshotsLocked(snapshots, address_first & 0x1FFFFFFF, address_last & 0x1FFFFFFF,
+                            UINT32_MAX);
+  if (!invalidated_by_gpu) {
+    snapshots.cpu_invalidations += snapshots.invalidations - before;
+  }
+}
+}  // namespace
