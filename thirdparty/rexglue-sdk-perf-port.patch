+void VulkanTextureCache::NoteSnapshotSkip(SnapshotSkip skip) {
+  ResolveSnapshots& snapshots = resolve_snapshots();
+  std::lock_guard<std::mutex> lock(snapshots.mutex);
+  if (uint32_t(skip) < uint32_t(SnapshotSkip::kCount)) ++snapshots.skips[uint32_t(skip)];
+}
+
+void VulkanTextureCache::InvalidateResolveSnapshots(uint32_t start, uint32_t length) {
+  if (!REXCVAR_GET(vulkan_resolve_texture_shortcut) || !length) return;
+  ResolveSnapshots& snapshots = resolve_snapshots();
+  std::lock_guard<std::mutex> lock(snapshots.mutex);
+  start &= 0x1FFFFFFF;
+  // The entry for this exact destination is invalidated too; a capture right after replaces it.
+  for (ResolveSnapshot& entry : snapshots.entries) {
+    if (entry.valid && entry.length && start < entry.address + entry.length &&
+        entry.address < start + length) {
+      entry.valid = false;
+      ++snapshots.invalidations;
+    }
+  }
+}
