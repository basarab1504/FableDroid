+void CommandProcessor::UpdateFrameStats() {
+  const uint64_t now = rex::chrono::Clock::QueryHostTickCount();
+  const uint64_t frequency = rex::chrono::Clock::QueryHostTickFrequency();
+  if (worker_tuning_started_) {
+    // Busy time = wall time since the previous swap minus time spent waiting for the guest.
+    // The wait counter restarts whenever the frame stats interval below restarts.
+    const uint64_t waited = frame_stats_guest_wait_ticks_.load(std::memory_order_relaxed);
+    if (frame_stats_start_tick_ != tuning_stats_start_seen_) {
+      tuning_stats_start_seen_ = frame_stats_start_tick_;
+      tuning_wait_at_last_swap_ = 0;
+    }
+    if (tuning_last_swap_tick_) {
+      const uint64_t wall = now - tuning_last_swap_tick_;
+      const uint64_t idle = std::min(wall, waited - std::min(waited, tuning_wait_at_last_swap_));
+      worker_tuning_.OnFrame(uint64_t(double(wall - idle) * 1e9 / double(frequency)));
+    }
+    tuning_last_swap_tick_ = now;
+    tuning_wait_at_last_swap_ = waited;
+  }
+  if (!REXCVAR_GET(log_frame_stats)) {
+    frame_stats_last_tick_ = frame_stats_start_tick_ = 0;
+    frame_stats_count_ = frame_stats_max_ticks_ = frame_stats_late_ = 0;
+    return;
+  }
+  if (!frame_stats_last_tick_) {
+    frame_stats_start_tick_ = now;
+    frame_stats_guest_wait_ticks_.store(0);
+    frame_stats_ring_wait_ticks_.store(0);
+    frame_stats_value_wait_ticks_.store(0);
+    frame_stats_last_tick_ = now;
+    return;
+  }
+  const uint64_t interval = now - frame_stats_last_tick_;
+  frame_stats_last_tick_ = now;
+  const double to_ms = 1000.0 / double(frequency);
+  const double interval_ms = double(interval) * to_ms;
+  if (REXCVAR_GET(log_late_frames)) {
+    // The wait counters restart with each stats interval; a smaller value means a restart.
+    static uint64_t late_ring = 0, late_value = 0, late_wait = 0;
+    const uint64_t ring = frame_stats_ring_wait_ticks_.load(std::memory_order_relaxed);
+    const uint64_t value = frame_stats_value_wait_ticks_.load(std::memory_order_relaxed);
+    const uint64_t wait = frame_stats_guest_wait_ticks_.load(std::memory_order_relaxed);
+    if (interval_ms > 45.0) {
+      REXGPU_INFO("Late frame: interval={:.1f}ms guest_wait={:.1f}ms ring_empty={:.1f}ms "
+                  "register_poll={:.1f}ms",
+                  interval_ms, double(wait >= late_wait ? wait - late_wait : wait) * to_ms,
+                  double(ring >= late_ring ? ring - late_ring : ring) * to_ms,
+                  double(value >= late_value ? value - late_value : value) * to_ms);
+    }
+    late_ring = ring;
+    late_value = value;
+    late_wait = wait;
+  }
+  ++frame_stats_count_;
+  frame_stats_max_ticks_ = std::max(frame_stats_max_ticks_, interval);
+  frame_stats_late_ += interval_ms > 45.0;
+  const uint64_t elapsed = now - frame_stats_start_tick_;
+  if (elapsed < frequency * 5) {
+    return;
+  }
+  REXGPU_INFO("Guest frame timing: {:.2f} FPS average, {:.2f} ms worst interval, "
+              "{}/{} intervals over 45 ms (includes loading/pauses)",
+              double(frame_stats_count_) * double(frequency) / double(elapsed),
+              double(frame_stats_max_ticks_) * to_ms, frame_stats_late_, frame_stats_count_);
+  REXGPU_INFO("GPU command worker: {:.0f}% of the interval idle waiting for guest "
+              "commands/values (high while below the target FPS = guest CPU limits it)",
+              double(frame_stats_guest_wait_ticks_.exchange(0)) * 100.0 / double(elapsed));
+  REXGPU_INFO("Worker wait split: ring_empty={:.2f}% memory_register_poll={:.2f}% (wall time "
+              "includes PrepareForWait/ReturnFromWait; value producer unclassified)",
+              double(frame_stats_ring_wait_ticks_.exchange(0)) * 100.0 / double(elapsed),
+              double(frame_stats_value_wait_ticks_.exchange(0)) * 100.0 / double(elapsed));
+  frame_stats_start_tick_ = now;
+  frame_stats_count_ = frame_stats_max_ticks_ = frame_stats_late_ = 0;
+}
