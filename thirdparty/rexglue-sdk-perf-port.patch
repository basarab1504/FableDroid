diff --git a/include/rex/graphics/vulkan/upload_page_cache.h b/include/rex/graphics/vulkan/upload_page_cache.h
new file mode 100644
index 0000000..b09b085
--- /dev/null
+++ b/include/rex/graphics/vulkan/upload_page_cache.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+namespace rex::graphics::vulkan {
+
+// Bounded, exact snapshots of CPU uploads. Collisions evict, never alias pages.
+class UploadPageCache {
+ public:
+  explicit UploadPageCache(size_t page_size, size_t budget = 16 * 1024 * 1024)
+      : page_size_(page_size), slots_(std::max(size_t(1), budget / page_size)) {}
+
+  bool Matches(uint32_t page, const void* bytes) const {
+    const auto& slot = slots_[page % slots_.size()];
+    return slot.valid && slot.page == page &&
+           std::memcmp(slot.bytes.get(), bytes, page_size_) == 0;
+  }
+
+  // Snapshot of a page stored by Store (valid until the slot is reused).
+  const uint8_t* Data(uint32_t page) const { return slots_[page % slots_.size()].bytes.get(); }
+  // Whether the slot holds a valid snapshot of this page (Data is then that snapshot).
+  bool Holds(uint32_t page) const {
+    const auto& slot = slots_[page % slots_.size()];
+    return slot.valid && slot.page == page;
+  }
+
+  void Store(uint32_t page, const void* bytes) {
+    auto& slot = slots_[page % slots_.size()];
+    if (!slot.bytes) slot.bytes = std::make_unique<uint8_t[]>(page_size_);
+    std::memcpy(slot.bytes.get(), bytes, page_size_);
+    slot.page = page;
+    slot.valid = true;
+  }
+
+  void Invalidate(uint32_t first, uint32_t count) {
+    if (count >= slots_.size()) {
+      for (auto& slot : slots_) {
+        if (slot.valid && slot.page >= first && uint64_t(slot.page) - first < count)
+          slot.valid = false;
+      }
+    } else {
+      for (uint64_t page = first; page < uint64_t(first) + count; ++page) {
+        auto& slot = slots_[page % slots_.size()];
+        if (slot.valid && slot.page == page) slot.valid = false;
+      }
+    }
+  }
+
+ private:
+  struct Slot {
+    std::unique_ptr<uint8_t[]> bytes;
+    uint32_t page = 0;
+    bool valid = false;
+  };
+  size_t page_size_;
+  std::vector<Slot> slots_;
+};
+
+}  // namespace rex::graphics::vulkan
diff --git a/include/rex/graphics/worker_thread_tuning.h b/include/rex/graphics/worker_thread_tuning.h
new file mode 100644
index 0000000..df1b22d
--- /dev/null
+++ b/include/rex/graphics/worker_thread_tuning.h
@@ -0,0 +1,169 @@
+#pragma once
+// Android scheduling hints for the GPU command worker thread.
+// Both are off by default and only change where and how fast the thread runs,
+// never what it computes.
+#include <chrono>
+#include <cstdint>
+#include <string>
+
+#if defined(__ANDROID__)
+#include <dlfcn.h>
+#include <sched.h>
+#include <unistd.h>
+#include <time.h>
+#include <cstdio>
+#include <vector>
+#endif
+
+#include <rex/logging.h>
+
+namespace rex::graphics {
+
+class WorkerThreadTuning {
+ public:
+  void Start(bool big_cores, bool adpf, uint32_t target_ms) {
+#if defined(__ANDROID__)
+    tid_ = gettid();
+    cpu_sample_ns_ = ReadThreadCpuNs();
+    cpu_sample_start_ = std::chrono::steady_clock::now();
+    if (big_cores) {
+      PinToBigCores();
+    }
+    if (adpf) {
+      CreateHintSession(target_ms);
+    }
+    REXGPU_INFO("Worker tuning: tid={} big_cores={} mask={} adpf={} target={}ms", tid_, big_cores,
+                mask_text_, session_ != nullptr, target_ms);
+#else
+    (void)big_cores;
+    (void)adpf;
+    (void)target_ms;
+#endif
+  }
+
+  // Called once per guest frame with the worker's busy time for that frame.
+  void OnFrame(uint64_t busy_ns) {
+#if defined(__ANDROID__)
+    if (session_ && report_) {
+      report_(session_, int64_t(busy_ns > 0 ? busy_ns : 1));
+    }
+    ++frames_;
+    busy_total_ns_ += busy_ns;
+    const int cpu = sched_getcpu();
+    if (cpu >= 0 && cpu < 32) {
+      ++cpu_frames_[cpu];
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - reported_ >= std::chrono::seconds(5)) {
+      std::string cpus;
+      for (int i = 0; i < 32; ++i) {
+        if (cpu_frames_[i]) {
+          cpus += (cpus.empty() ? "" : ",") + std::to_string(i) + ":" + std::to_string(cpu_frames_[i]);
+          cpu_frames_[i] = 0;
+        }
+      }
+      REXGPU_INFO("Worker tuning: frames={} busy_avg={:.2f}ms cpu_frames={} adpf={}", frames_,
+                  frames_ ? double(busy_total_ns_) / 1e6 / double(frames_) : 0.0, cpus,
+                  session_ != nullptr);
+      const uint64_t cpu_now = ReadThreadCpuNs();
+      const double wall_ms = std::chrono::duration<double, std::milli>(now-cpu_sample_start_).count();
+      if (cpu_now && cpu_sample_ns_ && cpu_now >= cpu_sample_ns_ && wall_ms > 0) {
+        const double cpu_ms = double(cpu_now-cpu_sample_ns_)/1e6;
+        REXGPU_INFO("Worker actual CPU: interval={:.3f}s threadCPU={:.3f}ms usage={:.1f}% frames={} CPU_per_frame={:.3f}ms (thread clock, not busy wall time)",
+                    wall_ms/1000.0, cpu_ms, cpu_ms*100.0/wall_ms, frames_, frames_ ? cpu_ms/double(frames_) : 0.0);
+      }
+      cpu_sample_ns_ = cpu_now;
+      cpu_sample_start_ = now;
+      frames_ = busy_total_ns_ = 0;
+      reported_ = now;
+    }
+#else
+    (void)busy_ns;
+#endif
+  }
+
+ private:
+#if defined(__ANDROID__)
+  using GetManagerFn = void* (*)();
+  using CreateSessionFn = void* (*)(void*, const int32_t*, size_t, int64_t);
+  using ReportFn = int (*)(void*, int64_t);
+
+  void PinToBigCores() {
+    // Keep every core faster than the slowest cluster; a single prime core
+    // would be shared with the guest threads.
+    const long count = sysconf(_SC_NPROCESSORS_CONF);
+    std::vector<long> max_freq;
+    long slowest = -1;
+    for (long cpu = 0; cpu < count && cpu < 32; ++cpu) {
+      char path[96];
+      std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%ld/cpufreq/cpuinfo_max_freq", cpu);
+      long freq = -1;
+      if (FILE* file = std::fopen(path, "r")) {
+        if (std::fscanf(file, "%ld", &freq) != 1) {
+          freq = -1;
+        }
+        std::fclose(file);
+      }
+      max_freq.push_back(freq);
+      if (freq > 0 && (slowest < 0 || freq < slowest)) {
+        slowest = freq;
+      }
+    }
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    int chosen = 0;
+    for (size_t cpu = 0; cpu < max_freq.size(); ++cpu) {
+      if (max_freq[cpu] > slowest) {
+        CPU_SET(cpu, &set);
+        mask_text_ += (mask_text_.empty() ? "" : ",") + std::to_string(cpu);
+        ++chosen;
+      }
+    }
+    if (!chosen) {
+      mask_text_ = "unchanged(uniform or unreadable cpufreq)";
+      return;
+    }
+    if (sched_setaffinity(0, sizeof(set), &set) != 0) {
+      mask_text_ += "(sched_setaffinity failed)";
+    }
+  }
+
+  void CreateHintSession(uint32_t target_ms) {
+    // APerformanceHint is API 33+; resolve it at run time so API 26 devices still load.
+    void* android = dlopen("libandroid.so", RTLD_NOW);
+    if (!android) {
+      return;
+    }
+    auto get_manager = reinterpret_cast<GetManagerFn>(dlsym(android, "APerformanceHint_getManager"));
+    auto create = reinterpret_cast<CreateSessionFn>(dlsym(android, "APerformanceHint_createSession"));
+    report_ = reinterpret_cast<ReportFn>(dlsym(android, "APerformanceHint_reportActualWorkDuration"));
+    if (!get_manager || !create || !report_) {
+      return;
+    }
+    void* manager = get_manager();
+    if (!manager) {
+      return;
+    }
+    const int32_t tids[] = {int32_t(tid_)};
+    session_ = create(manager, tids, 1, int64_t(target_ms) * 1000000);
+  }
+
+  static uint64_t ReadThreadCpuNs() {
+    timespec value{};
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &value) != 0) return 0;
+    return uint64_t(value.tv_sec)*1000000000ULL + uint64_t(value.tv_nsec);
+  }
+  uint64_t cpu_sample_ns_ = 0;
+  std::chrono::steady_clock::time_point cpu_sample_start_{};
+  pid_t tid_ = 0;
+  std::string mask_text_;
+  void* session_ = nullptr;
+  ReportFn report_ = nullptr;
+  uint64_t frames_ = 0;
+  uint64_t busy_total_ns_ = 0;
+  uint32_t cpu_frames_[32] = {};
+  std::chrono::steady_clock::time_point reported_ = std::chrono::steady_clock::now();
+#endif
+};
+
+}  // namespace rex::graphics
diff --git a/include/rex/thread/mutex.h b/include/rex/thread/mutex.h
index 6e5755a..c5425ba 100644
--- a/include/rex/thread/mutex.h
+++ b/include/rex/thread/mutex.h
@@ -11,10 +11,36 @@
 
 #pragma once
 
+#include <atomic>
+#include <cstdint>
 #include <mutex>
+#include <vector>
 
 namespace rex::thread {
 
+// log_global_lock: contention profiling of the global critical region. Off by default; while
+// off, Acquire/AcquireDirect cost one relaxed load more than before.
+extern std::atomic<bool> global_lock_profiling;
+// Locks `mutex`; if it was contended, records how long this thread waited and which thread
+// (the last profiled acquirer) held it, with both acquisition sites (return addresses).
+void GlobalLockAcquireProfiled(std::recursive_mutex& mutex);
+struct GlobalLockContention {
+  int waiter_tid, holder_tid;
+  uintptr_t waiter_site, holder_site;
+  uint64_t wait_ns;
+  uint32_t count;
+};
+// Returns and clears the contention records gathered since the last call.
+std::vector<GlobalLockContention> TakeGlobalLockContention();
+
+// guest_global_lock (cvar, default true): whether the recompiled guest's mfmsr/mtmsrd
+// interrupt-disable sections (REX_ENTER/LEAVE/CHECK_GLOBAL_LOCK) take the global critical
+// region. Every such section wraps a single lwarx/stwcx. pair, and stwcx. is a real
