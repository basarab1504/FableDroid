+// SIGPROF sampler state: the logger signals one thread at a time and waits for the handler.
+std::atomic<int> sample_target_tid{0};
+std::atomic<uint64_t> sample_sequence{0};
+std::atomic<uintptr_t> sample_pc{0}, sample_lr{0};
+// Return addresses from the frame-pointer chain at the sample, so time inside libc (futex,
+// write, mprotect) can be charged to the first caller outside libc.
+constexpr int kSampleFrames = 10;
+std::atomic<uintptr_t> sample_frames[kSampleFrames];
+
+void SampleSignalHandler(int, siginfo_t*, void* context) {
+  if (int(syscall(SYS_gettid)) != sample_target_tid.load(std::memory_order_acquire)) return;
+#if defined(__aarch64__)
+  const auto* uc = static_cast<const ucontext_t*>(context);
+  sample_pc.store(uintptr_t(uc->uc_mcontext.pc), std::memory_order_relaxed);
+  sample_lr.store(uintptr_t(uc->uc_mcontext.regs[30]), std::memory_order_relaxed);
+  // Walk x29 only while it stays inside this thread's stack above sp (16-byte aligned,
+  // increasing, within 1 MiB) so a garbage frame pointer is never dereferenced.
+  uintptr_t fp = uintptr_t(uc->uc_mcontext.regs[29]);
+  const uintptr_t sp = uintptr_t(uc->uc_mcontext.sp);
+  int depth = 0;
+  for (; depth < kSampleFrames; ++depth) {
+    if (!fp || (fp & 15) || fp < sp || fp - sp > (1u << 20)) break;
+    const uintptr_t* frame = reinterpret_cast<const uintptr_t*>(fp);
+    const uintptr_t next = frame[0], ret = frame[1];
+    if (!ret) break;
+    sample_frames[depth].store(ret, std::memory_order_relaxed);
+    if (next <= fp) { ++depth; break; }
+    fp = next;
+  }
+  for (; depth < kSampleFrames; ++depth) sample_frames[depth].store(0, std::memory_order_relaxed);
+#else
+  (void)context;
+#endif
+  sample_sequence.fetch_add(1, std::memory_order_release);
+}
+
+std::string DescribeCodeAddress(uintptr_t address) {
+  Dl_info info{};
+  if (!address || !dladdr(reinterpret_cast<void*>(address), &info) || !info.dli_fname) {
+    return fmt::format("?{:x}", address);
+  }
+  const char* slash = std::strrchr(info.dli_fname, '/');
+  std::string text = fmt::format("{}+0x{:x}", slash ? slash + 1 : info.dli_fname,
+                                 address - uintptr_t(info.dli_fbase));
+  if (info.dli_sname) text += fmt::format("({})", info.dli_sname);
+  return text;
+}
+
+// Interrupt one thread about 200 times over a second and log where it was (pc) and who
+// called that function (lr). Offsets are symbolized offline against the unstripped libraries.
+void SampleThread(int tid, const std::string& name) {
+#if defined(__aarch64__)
+  static std::once_flag installed;
+  std::call_once(installed, [] {
+    struct sigaction action{};
+    action.sa_sigaction = SampleSignalHandler;
+    action.sa_flags = SA_SIGINFO | SA_RESTART;
+    sigemptyset(&action.sa_mask);
+    sigaction(SIGPROF, &action, nullptr);
+  });
+  std::unordered_map<uintptr_t, uint32_t> pcs, lrs;
+  std::unordered_map<std::string, uint32_t> callers;
+  std::unordered_map<uintptr_t, bool> in_libc_cache;
+  auto in_libc = [&](uintptr_t address) {
+    auto it = in_libc_cache.find(address);
+    if (it != in_libc_cache.end()) return it->second;
+    Dl_info info{};
+    bool libc = false;
+    if (address && dladdr(reinterpret_cast<void*>(address), &info) && info.dli_fname) {
+      const char* slash = std::strrchr(info.dli_fname, '/');
+      const char* file = slash ? slash + 1 : info.dli_fname;
+      libc = !std::strcmp(file, "libc.so") || !std::strcmp(file, "libc++_shared.so");
+    }
+    return in_libc_cache[address] = libc;
+  };
+  uint32_t taken = 0;
+  sample_target_tid.store(tid, std::memory_order_release);
+  for (int i = 0; i < 200; ++i) {
+    const uint64_t before = sample_sequence.load(std::memory_order_acquire);
+    if (syscall(SYS_tgkill, getpid(), tid, SIGPROF) != 0) break;
+    for (int wait = 0; wait < 50 && sample_sequence.load(std::memory_order_acquire) == before; ++wait) {
+      std::this_thread::sleep_for(std::chrono::microseconds(100));
+    }
+    if (sample_sequence.load(std::memory_order_acquire) != before) {
+      ++pcs[sample_pc.load(std::memory_order_relaxed)];
+      ++lrs[sample_lr.load(std::memory_order_relaxed)];
+      ++taken;
+      // Key: the libc function sampled (if any) plus the first two callers outside libc.
+      const uintptr_t pc = sample_pc.load(std::memory_order_relaxed);
+      std::string key = in_libc(pc) ? DescribeCodeAddress(pc) + " <" : std::string();
+      int outside = 0;
+      uintptr_t chain[kSampleFrames + 1];
+      chain[0] = sample_lr.load(std::memory_order_relaxed);
+      for (int f = 0; f < kSampleFrames; ++f) chain[f + 1] = sample_frames[f].load(std::memory_order_relaxed);
+      for (int f = in_libc(pc) ? 0 : 1; f <= kSampleFrames && outside < 2; ++f) {
+        if (!chain[f] || in_libc(chain[f])) continue;
+        key += " " + DescribeCodeAddress(chain[f]);
+        ++outside;
+      }
+      if (!in_libc(pc)) key = DescribeCodeAddress(pc) + " <" + key;
+      ++callers[key];
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+  sample_target_tid.store(0, std::memory_order_release);
+  auto top = [](const std::unordered_map<uintptr_t, uint32_t>& counts) {
+    std::vector<std::pair<uintptr_t, uint32_t>> sorted(counts.begin(), counts.end());
+    std::sort(sorted.begin(), sorted.end(), [](auto& a, auto& b) { return a.second > b.second; });
+    std::string text;
+    for (size_t i = 0; i < sorted.size() && i < 8; ++i) {
+      text += fmt::format(" {}x{}", sorted[i].second, DescribeCodeAddress(sorted[i].first));
+    }
+    return text;
+  };
+  REXGPU_INFO("Thread samples [{}]{} n={} pc:{}", tid, name, taken, top(pcs));
+  REXGPU_INFO("Thread samples [{}]{} n={} lr:{}", tid, name, taken, top(lrs));
+  {
+    std::vector<std::pair<std::string, uint32_t>> sorted(callers.begin(), callers.end());
+    std::sort(sorted.begin(), sorted.end(), [](auto& a, auto& b) { return a.second > b.second; });
+    std::string text;
+    for (size_t i = 0; i < sorted.size() && i < 16; ++i) {
+      text += fmt::format(" | {}x {}", sorted[i].second, sorted[i].first);
+    }
+    REXGPU_INFO("Thread samples callers [{}]{} n={}{}", tid, name, taken, text);
+  }
+  if (REXCVAR_GET(log_thread_samples_all)) {
+    std::vector<std::pair<uintptr_t, uint32_t>> all(pcs.begin(), pcs.end());
+    std::sort(all.begin(), all.end(), [](auto& a, auto& b) { return a.second > b.second; });
+    std::string text;
+    for (const auto& [pc, count] : all) text += fmt::format(" {}x{}", count, DescribeCodeAddress(pc));
+    REXGPU_INFO("Thread samples all [{}]{} n={}:{}", tid, name, taken, text);
+  }
+#else
+  (void)tid;
+  (void)name;
+#endif
+}
+
+// /proc counterpart of the Win32 thread CPU logger: every 5 seconds, threads that used at
+// least 5% of one core, with their name and the CPU they last ran on.
+std::string ProcThreadName(int tid) {
+  char path[64];
+  std::snprintf(path, sizeof(path), "/proc/self/task/%d/comm", tid);
+  std::string name;
+  if (FILE* f = std::fopen(path, "r")) {
+    char buffer[64] = {};
+    if (std::fgets(buffer, sizeof(buffer), f)) name = buffer;
+    std::fclose(f);
+  }
+  while (!name.empty() && (name.back() == '\n' || name.back() == ' ')) name.pop_back();
+  return name.empty() ? fmt::format("tid{}", tid) : name;
+}
+
+// log_global_lock: who waited for the global critical region, for how long, and who held it.
+void LogGlobalLockContention() {
+  std::vector<rex::thread::GlobalLockContention> records = rex::thread::TakeGlobalLockContention();
+  if (records.empty()) return;
+  std::map<int, uint64_t> per_waiter;
+  uint64_t total = 0;
+  for (const auto& r : records) {
+    per_waiter[r.waiter_tid] += r.wait_ns;
+    total += r.wait_ns;
+  }
+  std::sort(records.begin(), records.end(),
+            [](const auto& a, const auto& b) { return a.wait_ns > b.wait_ns; });
+  std::string waiters;
+  for (const auto& [tid, ns] : per_waiter) {
+    if (ns >= 5000000) waiters += fmt::format(" {}={:.0f}ms", ProcThreadName(tid), ns / 1e6);
+  }
+  std::string text;
+  for (size_t i = 0; i < records.size() && i < 12; ++i) {
+    const auto& r = records[i];
+    text += fmt::format(" | {:.1f}ms n{} {}@{} <- {}@{}", r.wait_ns / 1e6, r.count,
+                        ProcThreadName(r.waiter_tid), DescribeCodeAddress(r.waiter_site),
+                        r.holder_tid ? ProcThreadName(r.holder_tid) : std::string("?"),
+                        DescribeCodeAddress(r.holder_site));
+  }
+  REXGPU_INFO("Global lock waits (5s): total={:.0f}ms per waiter:{}{}", total / 1e6, waiters,
+              text);
+}
+
+void StartProcThreadCpuLogger() {
+  static std::once_flag once;
+  std::call_once(once, [] {
+    if (REXCVAR_GET(log_global_lock)) rex::thread::global_lock_profiling.store(true);
+    std::thread([] {
+      struct Sample { uint64_t ticks; std::string name; int cpu; };
+      const double hz = double(sysconf(_SC_CLK_TCK) > 0 ? sysconf(_SC_CLK_TCK) : 100);
+      std::map<int, uint64_t> previous;
+      auto last = std::chrono::steady_clock::now();
+      for (;;) {
+        std::this_thread::sleep_for(std::chrono::seconds(5));
+        std::map<int, Sample> now_samples;
+        if (DIR* dir = opendir("/proc/self/task")) {
+          while (dirent* entry = readdir(dir)) {
+            const int tid = std::atoi(entry->d_name);
+            if (tid <= 0) continue;
+            char path[64];
+            std::snprintf(path, sizeof(path), "/proc/self/task/%d/stat", tid);
+            FILE* file = std::fopen(path, "r");
+            if (!file) continue;
+            char line[1024] = {};
+            const size_t read = std::fread(line, 1, sizeof(line) - 1, file);
+            std::fclose(file);
+            line[read] = 0;
+            // Format: tid (comm) state ...; comm may contain spaces, so split at the last ')'.
+            char* open = std::strchr(line, '(');
+            char* close = std::strrchr(line, ')');
+            if (!open || !close || close < open) continue;
+            std::string name(open + 1, close);
+            // Fields after ')': state(3) ... utime(14) stime(15) ... processor(39).
+            unsigned long long utime = 0, stime = 0;
+            int cpu = -1, field = 3;
+            for (char* token = std::strtok(close + 2, " "); token; token = std::strtok(nullptr, " "), ++field) {
+              if (field == 14) utime = std::strtoull(token, nullptr, 10);
+              else if (field == 15) stime = std::strtoull(token, nullptr, 10);
+              else if (field == 39) { cpu = std::atoi(token); break; }
+            }
+            now_samples[tid] = {uint64_t(utime + stime), name, cpu};
+          }
+          closedir(dir);
+        }
+        const auto now = std::chrono::steady_clock::now();
+        const double seconds = std::chrono::duration<double>(now - last).count();
+        last = now;
+        std::string busy;
+        int hottest_tid = 0;
+        double hottest_percent = 60.0;  // Only sample a thread that keeps most of a core busy.
+        std::string hottest_name;
+        const std::string sample_match = REXCVAR_GET(log_thread_samples_match);
+        int matched_tid = 0;
+        double matched_percent = 20.0;
+        std::string matched_name;
+        const int self_tid = int(syscall(SYS_gettid));
+        for (const auto& [tid, sample] : now_samples) {
+          const auto it = previous.find(tid);
+          if (it == previous.end() || sample.ticks < it->second) continue;
+          const double percent = double(sample.ticks - it->second) / hz / seconds * 100.0;
+          if (percent < 5.0) continue;
+          busy += fmt::format(" [{}]{}={:.0f}%@cpu{}", tid, sample.name, percent, sample.cpu);
+          if (tid != self_tid && percent > hottest_percent) {
+            hottest_percent = percent;
+            hottest_tid = tid;
+            hottest_name = sample.name;
+          }
+          if (tid != self_tid && !sample_match.empty() && percent > matched_percent &&
+              sample.name.find(sample_match) != std::string::npos) {
+            matched_percent = percent;
+            matched_tid = tid;
+            matched_name = sample.name;
+          }
+        }
+        previous.clear();
+        for (const auto& [tid, sample] : now_samples) previous[tid] = sample.ticks;
+        if (!busy.empty()) REXGPU_INFO("Thread CPU (>=5% of a core, 5s):{}", busy);
+        if (REXCVAR_GET(log_global_lock)) LogGlobalLockContention();
+        if (hottest_tid && REXCVAR_GET(log_thread_samples)) {
+          // The next interval starts at `last`, before sampling, so its CPU share stays exact.
+          SampleThread(hottest_tid, hottest_name);
+        }
+        if (matched_tid && matched_tid != hottest_tid && REXCVAR_GET(log_thread_samples)) {
+          SampleThread(matched_tid, matched_name);
+        }
+      }
+    }).detach();
+  });
+}
+#endif
