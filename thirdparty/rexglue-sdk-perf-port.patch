+        source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, entry->image,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+  }
+  command_processor_.PushImageMemoryBarrier(
+      entry->image, ui::vulkan::util::InitializeSubresourceRange(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  entry->written = true;
+  entry->address = address;
+  entry->length = length;
+  entry->width = width;
+  entry->height = height;
+  entry->pitch_texels = pitch_texels;
+  entry->endian = endian;
+  entry->valid = true;
+  ++snapshots.captures;
+  return true;
+}
+
+void VulkanTextureCache::NoteResolveWrite(uint32_t address, uint32_t length) {
+  if (!REXCVAR_GET(log_resolve_texture_loads) || !length) return;
+  ResolveLoadStats& stats = resolve_load_stats();
+  std::lock_guard<std::mutex> lock(stats.mutex);
+  stats.ranges[stats.next++ % ResolveLoadStats::kRanges] = {address & 0x1FFFFFFF, length};
+  ++stats.resolves;
+}
