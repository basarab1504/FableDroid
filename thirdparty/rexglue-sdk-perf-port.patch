+// Called with the global lock held, for the page of a guest write-watch fault.
+void SharedMemory::NoteWriteFault(uint32_t page) {
+  if (page >= page_fault_heat_.size()) return;
+  const uint32_t now = HotClockMs();
+  uint8_t& heat = page_fault_heat_[page];
+  heat = (now - page_last_fault_ms_[page] <= kHotFaultGapMs) ? uint8_t(std::min(heat + 1, 255)) : 1;
+  page_last_fault_ms_[page] = now;
+  const uint64_t bit = uint64_t(1) << (page & 63);
+  if (heat < kHotFaults || (system_page_flags_hot_[page >> 6] & bit) ||
+      (system_page_flags_valid_and_gpu_written_[page >> 6] & bit) || PageHasRangeWatch(page)) {
+    return;
+  }
+  system_page_flags_hot_[page >> 6] |= bit;
+  page_hot_match_streak_[page] = 0;
+  hot_page_count_.fetch_add(1, std::memory_order_relaxed);
+  ++hot_page_stats_.made_hot;
+}
+
+void SharedMemory::CoolHotPages(uint32_t page_first, uint32_t page_last, bool protect) {
+  if (!hot_page_count_.load(std::memory_order_relaxed)) return;
+  auto global_lock = global_critical_region_.Acquire();
+  page_last = std::min(page_last, uint32_t(page_fault_heat_.size()) - 1);
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    const uint64_t bit = uint64_t(1) << (page & 63);
+    if (!(system_page_flags_hot_[page >> 6] & bit)) continue;
+    system_page_flags_hot_[page >> 6] &= ~bit;
+    page_fault_heat_[page] = 0;
+    hot_page_count_.fetch_sub(1, std::memory_order_relaxed);
+    ++hot_page_stats_.cooled;
+    if (protect && memory_invalidation_callback_handle_ &&
+        (system_page_flags_valid_[page >> 6] & bit)) {
+      memory().EnablePhysicalMemoryAccessCallbacks(page << page_size_log2_, 1u << page_size_log2_,
+                                                   true, false);
+    }
+  }
+}
+
+void SharedMemory::NoteHotPageCompared(uint32_t page, bool matched) {
+  if (page >= page_hot_match_streak_.size()) return;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    ++hot_page_stats_.compared;
+    if (!matched) {
+      ++hot_page_stats_.changed;
+      page_hot_match_streak_[page] = 0;
+      return;
+    }
+    if (++page_hot_match_streak_[page] < kCoolMatches) return;
+  }
+  CoolHotPages(page, page, true);
+}
