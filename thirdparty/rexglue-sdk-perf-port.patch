+namespace rex::ui::vulkan {
+// Only the presentation call moves. All command buffers stay on queue zero.
+constexpr uint32_t PresentQueueCount(bool requested, bool swapchain, bool gpu,
+                                     uint32_t available) {
+  return requested && swapchain && gpu && available >= 2 ? 2 : 1;
+}
+constexpr uint32_t PresentQueueIndex(uint32_t graphics_family, uint32_t present_family,
+                                     uint32_t reserved_index) {
+  return graphics_family == present_family ? reserved_index : 0;
+}
