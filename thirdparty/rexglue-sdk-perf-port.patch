+
+bool VulkanSharedMemory::FilterUnchangedUploads(
+    const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges,
+    std::vector<std::pair<uint32_t, uint32_t>>& changed_ranges) {
+  if (!upload_cache_) {
+    upload_cache_ = std::make_unique<UploadPageCache>(size_t(1) << page_size_log2());
+  }
+  static uint64_t checked_pages = 0, reused_pages = 0;
+  static auto window = std::chrono::steady_clock::now();
+  const uint32_t page_size_bytes = uint32_t(1) << page_size_log2();
+  auto append_changed = [&changed_ranges](uint32_t page) {
+    if (!changed_ranges.empty() &&
+        changed_ranges.back().first + changed_ranges.back().second == page) {
+      ++changed_ranges.back().second;
+    } else {
+      changed_ranges.emplace_back(page, 1);
+    }
+  };
+  if (REXCVAR_GET(vulkan_batch_upload_cache_rearm)) {
+    // Rearm the write watches of each run of unchanged pages with one call instead of one per
+    // page (each a host mprotect on every physical alias), then recheck every page, so a
+    // guest write between the first check and the rearm is still caught.
+    for (const auto& range : upload_page_ranges) {
+      const uint32_t end = range.first + range.second;
+      uint32_t page = range.first;
+      while (page < end) {
+        uint32_t run_end = page;
+        while (run_end < end &&
+               upload_cache_->Matches(run_end,
+                                      memory().TranslatePhysical(run_end << page_size_log2()))) {
+          ++run_end;
+        }
+        if (run_end == page) {
+          ++checked_pages;
+          if (IsPageHot(page)) NoteHotPageCompared(page, false);
+          append_changed(page++);
+          continue;
+        }
+        checked_pages += run_end - page;
+        MakeRangeValid(page << page_size_log2(), (run_end - page) << page_size_log2(), false);
+        for (; page < run_end; ++page) {
+          const uint32_t address = page << page_size_log2();
+          if (IsPageHot(page)) {
+            // Unwatched: this comparison is the only change detection. If it turns the page
+            // back into a watched one, compare once more after the watch is armed.
+            bool matched = upload_cache_->Matches(page, memory().TranslatePhysical(address));
+            NoteHotPageCompared(page, matched);
+            if (matched && !IsPageHot(page)) {
+              matched = upload_cache_->Matches(page, memory().TranslatePhysical(address));
+            }
+            if (matched) {
+              ++reused_pages;
+              continue;
+            }
+            MemoryInvalidationCallback(address, page_size_bytes, true);
+            append_changed(page);
+            continue;
+          }
+          if (upload_cache_->Matches(page, memory().TranslatePhysical(address))) {
+            ++reused_pages;
+            continue;
+          }
+          MemoryInvalidationCallback(address, page_size_bytes, true);
+          append_changed(page);
+        }
+      }
+    }
+  } else {
+    for (const auto& range : upload_page_ranges) {
+      for (uint32_t page = range.first; page < range.first + range.second; ++page) {
+        ++checked_pages;
+        const uint32_t address = page << page_size_log2();
+        const void* source = memory().TranslatePhysical(address);
+        if (upload_cache_->Matches(page, source)) {
+          // Rearm write watches before rechecking, so later guest writes invalidate residency.
+          MakeRangeValid(address, page_size_bytes, false);
+          if (upload_cache_->Matches(page, source)) {
+            ++reused_pages;
+            continue;
+          }
+          MemoryInvalidationCallback(address, page_size_bytes, true);
+        }
+        append_changed(page);
+      }
+    }
+  }
+  if (REXCVAR_GET(log_frame_stats) &&
+      std::chrono::steady_clock::now() - window >= std::chrono::seconds(5)) {
+    REXGPU_INFO("CPU upload cache: checked_pages={} reused_pages={}", checked_pages, reused_pages);
+    uint32_t hot_now = 0;
+    const HotPageStats hot = TakeHotPageStats(hot_now);
+    REXGPU_INFO("Hot pages: hot={} made_hot={} cooled={} compared={} changed={}", hot_now,
+                hot.made_hot, hot.cooled, hot.compared, hot.changed);
+    checked_pages = reused_pages = 0;
+    window = std::chrono::steady_clock::now();
+  }
+  return !changed_ranges.empty();
+}
